{
  "name": "pamatcad",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "workspaces": [
    "sdk/javascript"
  ],
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "build:core": "cargo build --locked -p pamatcad-host",
    "generate:protocol": "cargo run --locked --quiet -p pamatcad-host -- bindings --output sdk/javascript/src/generated/protocol.ts",
    "build:sdk": "npm run generate:protocol && npm run build --workspace @pamatcad/sdk",
    "build:user-docs": "npm run build:sdk && node tools/docs/build-user.mjs",
    "build:api-docs": "npm run build:sdk && node sdk/reference/build.mjs",
    "build": "npm run build:core && npm run build:sdk",
    "test": "npm run test:api --",
    "pretest:api": "node -e \"require('node:fs').rmSync('tests/dist', { recursive: true, force: true })\"",
    "test:api": "npm run build && tsc -p tests && node tests/run.mjs",
    "test:sdk": "npm run test:api --"
  },
  "devDependencies": {
    "@types/node": "24.19.2",
    "marked": "18.2.0",
    "typescript": "5.9.3"
  },
  "packageManager": "pnpm@12.16.1+sha512.091d1dee7927575661b25dab3c2ae31cafc1c54d6b71ed6a6600cf0c1cb10434a447eae14015f1b23e2e6bedeed79df94a932e2164d2832280dce3fb32f656d1"
}
