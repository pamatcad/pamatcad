{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "PamatCAD",
  "identifier": "org.pamatcad.editor",
  "build": {
    "beforeBuildCommand": "npm run desktop-ui",
    "frontendDist": "../../../build/desktop-ui"
  },
  "app": {
    "windows": [{ "label": "main", "create": false, "title": "PamatCAD", "width": 1280, "height": 840, "minWidth": 800, "minHeight": 600 }]
  },
  "bundle": { "active": true, "icon": ["icons/icon.png", "icons/icon.icns", "icons/icon.ico"] }
}
